sequenceDiagram
    participant User
    participant System
    participant ProcessModel
    participant AbstractSensor
    participant AbstractCalculation
    participant ControlElement
    participant AbstractController
    participant PointRegistry

    Note over System, PointRegistry: Simulation Loop (step)

    User->>System: step(duration)
    activate System
    
    Note right of System: Determine nsteps based on dt
    
    loop Every dt
        System->>System: _update_components()
        activate System
        
        %% Sensors Update
        rect rgb(230, 240, 255)
            Note over System, AbstractSensor: 1. Update Sensors
            loop For each Sensor
                System->>AbstractSensor: measure(t)
                activate AbstractSensor
                AbstractSensor->>ProcessModel: get_state()
                ProcessModel-->>AbstractSensor: raw_value
                AbstractSensor->>AbstractSensor: apply noise/faults
                AbstractSensor->>PointRegistry: update measurement point data
                deactivate AbstractSensor
            end
        end

        %% Calculations Update
        rect rgb(255, 240, 230)
            Note over System, AbstractCalculation: 2. Update Calculations
            loop For each Calculation
                System->>AbstractCalculation: calculate(t)
                activate AbstractCalculation
                AbstractCalculation->>PointRegistry: query calculation inputs
                PointRegistry-->>AbstractCalculation: calculation inputs
                AbstractCalculation->>AbstractCalculation: run algorithm
                AbstractCalculation->>PointRegistry: update calculation output data
                deactivate AbstractCalculation
            end
        end

        %% Control Elements Update
        rect rgb(230, 255, 240)
            Note over System, ControlElement: 3. Update Control Elements
            loop For each ControlElement
                System->>ControlElement: update(t)
                activate ControlElement
                
                Note over ControlElement: See control_loop_example.mermaid for details
                
                alt Mode is AUTO
                    rect rgb(235, 255, 235)
                        ControlElement->>AbstractController: update(t)
                        activate AbstractController
                        AbstractController->>PointRegistry: update reference point data
                        AbstractController-->>ControlElement: MV
                        deactivate AbstractController
                    end
                else Mode is MANUAL
                    rect rgb(255, 235, 235)
                        ControlElement->>ControlElement: get MV from trajectory
                    end
                end
                
                ControlElement->>ProcessModel: set MV state
                deactivate ControlElement
            end
        end

        deactivate System

        %% Process Step
        rect rgb(240, 240, 240)
            Note over System, ProcessModel: 4. Advance Process
            System->>ProcessModel: step(dt)
            activate ProcessModel
            ProcessModel->>ProcessModel: integrate ODEs (solve_ivp)
            deactivate ProcessModel
        end
    end
    
    deactivate System
