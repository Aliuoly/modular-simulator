{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "plugin": [],
  "mcp": {
    "paper_search_mcp": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory",
        "/home/alden/.local/share/opencode/paper-search-mcp",
        "-m",
        "paper_search_mcp.server"
      ],
      "enabled": true,
      "environment": {
        "PAPER_SEARCH_MCP_UNPAYWALL_EMAIL": "{env:PAPER_SEARCH_MCP_UNPAYWALL_EMAIL}",
        "PAPER_SEARCH_MCP_CORE_API_KEY": "{env:PAPER_SEARCH_MCP_CORE_API_KEY}",
        "PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY": "{env:PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY}",
        "PAPER_SEARCH_MCP_DOAJ_API_KEY": "{env:PAPER_SEARCH_MCP_DOAJ_API_KEY}",
        "PAPER_SEARCH_MCP_ZENODO_ACCESS_TOKEN": "{env:PAPER_SEARCH_MCP_ZENODO_ACCESS_TOKEN}",
        "PAPER_SEARCH_MCP_GOOGLE_SCHOLAR_PROXY_URL": "{env:PAPER_SEARCH_MCP_GOOGLE_SCHOLAR_PROXY_URL}",
        "PAPER_SEARCH_MCP_OPENAIRE_API_KEY": "{env:PAPER_SEARCH_MCP_OPENAIRE_API_KEY}",
        "PAPER_SEARCH_MCP_CITESEERX_API_KEY": "{env:PAPER_SEARCH_MCP_CITESEERX_API_KEY}",
        "PAPER_SEARCH_MCP_IEEE_API_KEY": "{env:PAPER_SEARCH_MCP_IEEE_API_KEY}",
        "PAPER_SEARCH_MCP_ACM_API_KEY": "{env:PAPER_SEARCH_MCP_ACM_API_KEY}"
      }
    },
    "zotero": {
      "type": "local",
      "command": ["npx", "-y", "@xevos117/mcp-zotero"],
      "enabled": false,
      "environment": {
        "ZOTERO_API_KEY": "{env:ZOTERO_API_KEY}",
        "ZOTERO_USER_ID": "{env:ZOTERO_USER_ID}",
        "UNPAYWALL_EMAIL": "{env:UNPAYWALL_EMAIL}",
        "UNSAFE_OPERATIONS": "none"
      }
    }
  },
  "tools": {
    "paper_search_mcp_*": false,
    "zotero_*": false
  },
  "agent": {
    "literature-reviewer": {
      "tools": {
        "paper_search_mcp_*": true,
        "zotero_*": true
      }
    },
    "plan": {
      "disable": true
    },
    "general":{
      "disable": true
    }
  }
}
