[node name="TutorialButton" type="Button" parent="Center/VBox"]
layout_mode = 2
text = "Start Heater + Flash Tutorial"

[connection signal="pressed" from="Center/VBox/SandboxButton" to="." method="_on_sandbox_pressed"]
[connection signal="pressed" from="Center/VBox/TutorialButton" to="." method="_on_tutorial_pressed"]
